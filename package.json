{
  "name": "web-interview",
  "version": "1.0.0",
  "private": true,
  "description": "Sellpy web interview assignment",
  "scripts": {
    "watch": "node scripts/watch.ts",
    "verify": "node scripts/verify.ts",
    "coverage:update-baseline": "COVERAGE_EVIDENCE_MODE=update-baseline node scripts/verify.ts unit storybook coverage",
    "coverage:check-storybook-stability": "node scripts/run-storybook-coverage.ts --stability",
    "test": "node scripts/verify.ts",
    "lint": "node scripts/verify.ts lint",
    "typecheck": "npm run build:types && node scripts/check-declarations.ts && tsc -p jsconfig.json && tsc -p shared/jsconfig.json && tsc -p backend/jsconfig.json && tsc -p frontend/jsconfig.json && tsc -p tsconfig.declarations.json",
    "storybook": "npm run storybook --prefix frontend",
    "e2e:ui": "node scripts/e2e-ui.ts",
    "preview": "node scripts/demo.ts",
    "whiteboard": "node scripts/whiteboard.ts",
    "kill": "node scripts/kill-ports.ts",
    "build:types": "npm run build:types --prefix shared",
    "postinstall": "npm run build:types"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/punycode": "^2.1.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "4.1.10",
    "@web-interview/todos": "file:shared",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^17.9.0",
    "lighthouse": "13.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}

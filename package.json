{
  "name": "web-interview",
  "version": "1.0.0",
  "private": true,
  "description": "Sellpy web interview assignment",
  "scripts": {
    "watch": "node scripts/watch.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs",
    "lint": "node scripts/verify.mjs lint",
    "typecheck": "npm run build:types && node scripts/check-declarations.mjs && tsc -p jsconfig.json && tsc -p shared/jsconfig.json && tsc -p backend/jsconfig.json && tsc -p frontend/jsconfig.json && tsc -p tsconfig.declarations.json",
    "storybook": "npm run storybook --prefix frontend",
    "preview": "node scripts/demo.mjs",
    "whiteboard": "node scripts/whiteboard.mjs",
    "kill": "lsof -ti tcp:3000 -i tcp:3001 -i tcp:3100 -i tcp:3101 -i tcp:3200 -i tcp:3201 -i tcp:4173 -i tcp:6006 -sTCP:LISTEN | xargs kill",
    "build:types": "npm run build:types --prefix shared",
    "postinstall": "npm run build:types"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/punycode": "^2.1.4",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@web-interview/todos": "file:shared",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "lighthouse": "13.4.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "glob": "^13.0.0"
  }
}

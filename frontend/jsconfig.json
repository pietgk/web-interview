{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.logic.config.ts",
    "vitest.storybook.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}

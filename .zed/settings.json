{
  "auto_install_extensions": {
    "tsgo": true
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "JSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    }
  }
}

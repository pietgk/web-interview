{
  "name": "@web-interview/todos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/types",
    "src/calendarDate.ts",
    "src/datom.ts",
    "src/datomStore.ts",
    "src/selectors.ts",
    "src/todoProtocol.ts",
    "src/types.ts",
    "src/ulid.ts"
  ],
  "exports": {
    "./datom": {
      "types": "./dist/types/datom.d.ts",
      "default": "./src/datom.ts"
    },
    "./datom-store": {
      "types": "./dist/types/datomStore.d.ts",
      "default": "./src/datomStore.ts"
    },
    "./protocol": {
      "types": "./dist/types/todoProtocol.d.ts",
      "default": "./src/todoProtocol.ts"
    },
    "./selectors": {
      "types": "./dist/types/selectors.d.ts",
      "default": "./src/selectors.ts"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./ulid": {
      "types": "./dist/types/ulid.d.ts",
      "default": "./src/ulid.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "prepack": "npm run build:types",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

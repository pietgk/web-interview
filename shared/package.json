{
  "name": "@web-interview/todos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/types",
    "src/calendarDate.js",
    "src/datom.js",
    "src/datomStore.js",
    "src/selectors.js",
    "src/todoProtocol.js",
    "src/types.js",
    "src/ulid.js"
  ],
  "exports": {
    "./datom": {
      "types": "./dist/types/datom.d.ts",
      "default": "./src/datom.js"
    },
    "./datom-store": {
      "types": "./dist/types/datomStore.d.ts",
      "default": "./src/datomStore.js"
    },
    "./protocol": {
      "types": "./dist/types/todoProtocol.d.ts",
      "default": "./src/todoProtocol.js"
    },
    "./selectors": {
      "types": "./dist/types/selectors.d.ts",
      "default": "./src/selectors.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "default": "./src/types.js"
    },
    "./ulid": {
      "types": "./dist/types/ulid.d.ts",
      "default": "./src/ulid.js"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "prepack": "npm run build:types",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2"
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "exec",
        "node@22",
        "--",
        "node",
        "frontend/node_modules/vite/bin/vite.js",
        "frontend",
        "--config",
        "frontend/vite.config.js"
      ],
      "port": 3000
    },
    {
      "name": "storybook",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "exec",
        "node@22",
        "--",
        "node",
        "frontend/node_modules/storybook/dist/bin/dispatcher.js",
        "dev",
        "-p",
        "6006",
        "--config-dir",
        "frontend/.storybook",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
